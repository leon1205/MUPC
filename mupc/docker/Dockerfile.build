# Dockerfile.build — MUPC ARM64 交叉编译构建环境 (骨架)
#
# 用于离线/自托管构建场景，当 cross 工具不可用时作为备用方案。
# Phase 2+ 完善（添加 RKNN SDK 安装、sccache 集成）。

FROM arm64v8/ubuntu:22.04

LABEL description="MUPC ARM64 Build Environment (Ubuntu 22.04)"
LABEL version="0.1.0"

# 防止交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 基础开发工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    libstdc++-12-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 Rust 工具链
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="$CARGO_HOME/bin:$PATH"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal

# 添加 ARM64 target
RUN rustup target add aarch64-unknown-linux-gnu

# Phase 2+: 添加 RKNN SDK
# COPY vendor/rknn/librknnrt.so /opt/rknn/lib/
# ENV RKNN_VENDOR_DIR=/opt/rknn/lib

# Phase 2+: 添加 sccache
# RUN cargo install sccache
# ENV RUSTC_WRAPPER=sccache

WORKDIR /workspace/mupc

# 入口: 编译命令
# docker run --rm -v $(pwd):/workspace/mupc mupc-build:latest \
#   cargo build -p mupc-core-bin --release --target aarch64-unknown-linux-gnu --features npu
