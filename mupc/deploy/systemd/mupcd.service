[Unit]
Description=MUPC 微电网特种调控装置通信管理模块
Documentation=https://github.com/your-org/mupc
After=network.target remote-fs.target nss-lookup.target

[Service]
Type=simple
User=mupc
Group=mupc
SupplementaryGroups=dialout
ExecStart=/opt/mupc/bin/mupcd \
    --config /opt/mupc/config/mupc_core_config.yaml \
    --model-dir /opt/mupc/models \
    --log-dir /opt/mupc/logs
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# /opt/mupc/config 必须可写：本地屏「配置保存」走 ConfigService 的原子落盘
# （tmp -> fsync -> .bak -> rename），目标是 --config 指向的 mupc_core_config.yaml。
# ProtectSystem=strict 使整个文件系统只读，不列入 ReadWritePaths 即写必然 EROFS
# ⇒ 屏上每次保存都失败（设计文档 §12.2 / §14 R-11 的「配置热写前提」）。
# 另需文件属主可写：chown mupc:mupc /opt/mupc/config/*.yaml
ReadWritePaths=/opt/mupc/data /opt/mupc/logs /opt/mupc/models /opt/mupc/config
ReadOnlyPaths=/opt/mupc/bin /opt/mupc/lib /opt/mupc/certs

# 资源限制
LimitNOFILE=4096
LimitNPROC=512
MemoryMax=512M

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mupcd

[Install]
WantedBy=multi-user.target
